---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../config';
---

<BaseLayout
  title="Contact | Amber Uncut"
  description="Book a chair at Cuts by Amber, or find Amber on Instagram, Facebook, and Google."
>
  <SiteHeader />

  <main>
    <article class="full-story" aria-labelledby="contact-title">
      <div class="story-kicker"><span>CONTACT</span><span>SAY HELLO</span></div>
      <h1 id="contact-title">Come sit in <em>my chair.</em></h1>
      <div class="full-story-copy">
        <p>
          Ready for a cut? Booking happens over at the salon site. If you would rather just say hi,
          send me a message on any of these and I will get back to you as soon as I am out from
          behind the chair.
        </p>

        <ul class="contact-links">
          <li>
            <a href={SITE.salon} rel="noopener" target="_blank">
              <span>Book an appointment</span>
              <span>cutsbyamber.com</span>
            </a>
          </li>
          <li>
            <a href={SITE.instagram} rel="me noopener" target="_blank">
              <span>Instagram</span>
              <span>@cuts_by_amber</span>
            </a>
          </li>
          <li>
            <a href={SITE.facebook} rel="me noopener" target="_blank">
              <span>Facebook</span>
              <span>Cuts by Amber</span>
            </a>
          </li>
          <li>
            <a href={SITE.google} rel="noopener" target="_blank">
              <span>Google</span>
              <span>Reviews and directions</span>
            </a>
          </li>
        </ul>

        <p>
          If you would rather read than talk, the <a href="/archive/">archive</a> is where all the
          notes live, and you can get new ones by email from the
          <a href="/#letters">home page</a>.
        </p>
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
