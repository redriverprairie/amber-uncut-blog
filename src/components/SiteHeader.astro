---
import { SITE } from '../config';

interface Props {
  variant?: 'home' | 'inner';
}

const { variant = 'inner' } = Astro.props;
---

<header class="site-header">
  <a class="wordmark" href={variant === 'home' ? '#top' : '/'} aria-label="Amber Uncut home">
    AMBER <em>UNCUT</em>
  </a>

  {
    variant === 'home' && (
      <>
        <button class="menu-button" aria-label="Open menu" aria-expanded="false">
          <i data-lucide="menu" />
        </button>
        <nav class="main-nav" aria-label="Primary navigation">
          <a href="#latest">Latest</a>
          <a href="#culture">Learning</a>
          <a href="#body">Notes</a>
          <a href="#letters">Letters</a>
        </nav>
      </>
    )
  }

  <div class="header-actions">
    <a class="book-link" href={SITE.salon} rel="noopener" target="_blank">
      Book a cut <i data-lucide="arrow-up-right"></i>
    </a>
    {
      variant === 'home' ? (
        <a class="issue-link" href="#letters">
          Stay in touch
        </a>
      ) : (
        <a class="issue-link" href="/">
          Back to home
        </a>
      )
    }
  </div>
</header>
